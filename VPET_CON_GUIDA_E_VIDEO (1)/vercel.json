{
  "cleanUrls": true,
  "rewrites": [
    { "source": "/salute-benessere", "destination": "/index.html" },
    { "source": "/alimentazione-allergie", "destination": "/index.html" },
    { "source": "/lettiera", "destination": "/index.html" },
    { "source": "/adozioni", "destination": "/index.html" },
    { "source": "/razze", "destination": "/index.html" },
    { "source": "/viaggia-insieme", "destination": "/index.html" },
    { "source": "/pet-culture", "destination": "/index.html" },
    { "source": "/animali-nella-storia", "destination": "/index.html" },
    { "source": "/qui-siamo-stati-bene", "destination": "/index.html" },
    { "source": "/chiedi-a-vpet", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}